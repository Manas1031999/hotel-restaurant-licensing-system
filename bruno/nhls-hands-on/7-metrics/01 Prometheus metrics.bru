meta {
  name: 01 Prometheus metrics
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/actuator/prometheus
  body: none
  auth: none
}

tests {
  test("token ছাড়াই খোলা, নিজেদের metric আছে", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.include("nhls_workflow_transitions_total");
    expect(res.body).to.include("nhls_notifications_pending");
  });
}
