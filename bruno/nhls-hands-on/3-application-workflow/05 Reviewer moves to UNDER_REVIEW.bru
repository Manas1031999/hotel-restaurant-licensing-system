meta {
  name: 05 Reviewer moves to UNDER_REVIEW
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/license-applications/{{appNo}}/review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reviewerToken}}
}

body:json {
  {
    "applicationStatus": "UNDER_REVIEW",
    "remarks": "কাগজপত্র দেখা হচ্ছে"
  }
}

tests {
  test("reviewer review শুরু করল (200)", function () {
    expect(res.status).to.equal(200);
  });
}
