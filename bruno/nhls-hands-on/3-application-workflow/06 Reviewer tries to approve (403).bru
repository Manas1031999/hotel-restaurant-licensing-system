put {
  url: {{baseUrl}}/api/v1/license-applications/{{appNo}}/review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reviewerToken}}
}

body:json {
  {
    "applicationStatus": "APPROVED",
    "remarks": "x"
  }
}

tests {
  test("approve শুধু APPROVER পারে (403)", function () {
    expect(res.status).to.equal(403);
  });
}
