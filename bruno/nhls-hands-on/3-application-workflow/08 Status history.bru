meta {
  name: 08 Status history
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/license-applications/{{appNo}}/status-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

tests {
  test("৩ ধাপ, প্রতিটায় কে করল", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map(h => h.newStatus)).to.deep.equal(["PENDING", "UNDER_REVIEW", "APPROVED"]);
    expect(res.body.map(h => h.changedBy)).to.deep.equal([bru.getVar("applicantA"), bru.getVar("reviewer"), bru.getVar("approver")]);
  });
}
