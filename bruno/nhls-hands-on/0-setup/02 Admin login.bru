meta {
  name: 02 Admin login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.data.accessToken);
}

tests {
  test("admin login সফল, token পাওয়া গেছে", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.role).to.equal("ADMIN");
    expect(res.body.data.accessToken).to.be.a("string");
  });
}
