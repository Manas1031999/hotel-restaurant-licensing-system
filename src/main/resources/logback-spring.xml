<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="wb-nhls"/>
    <springProperty scope="context" name="lokiUrl" source="nhls.loki.url" defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- observability profile চালু থাকলে log Loki-তেও যায় -->
    <springProfile name="observability">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
            </http>
            <format>
                <label>
                    <pattern>app=${appName},level=%level,logger=%logger{20}</pattern>
                </label>
                <message>
                    <pattern>%d{ISO8601} %-5level [%thread] %logger{36} - %msg%n%ex</pattern>
                </message>
            </format>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
