meta {
  name: 02 Wrong password gets 401
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{applicantA}}",
    "password": "wrong-password"
  }
}

tests {
  test("ভুল password 401; username আছে কিনা বোঝা যায় না", function () {
    expect(res.status).to.equal(401);
  });
}
