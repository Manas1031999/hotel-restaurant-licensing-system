meta {
  name: 06 Register applicant B
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{applicantB}}",
    "password": "{{userPassword}}",
    "fullName": "Karim"
  }
}

tests {
  test("নিজে register করলে সবসময় APPLICANT (201)", function () {
    expect(res.status).to.equal(201);
    expect(res.body.data.role).to.equal("APPLICANT");
  });
}
