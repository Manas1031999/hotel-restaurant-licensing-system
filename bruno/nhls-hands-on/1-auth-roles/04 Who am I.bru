meta {
  name: 04 Who am I
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenA}}
}

tests {
  test("token থেকে বর্তমান user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.username).to.equal(bru.getVar("applicantA"));
  });
}
