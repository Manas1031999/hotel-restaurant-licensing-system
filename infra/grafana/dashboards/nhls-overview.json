{
  "uid": "nhls-overview",
  "title": "NHLS - Licensing System Overview",
  "tags": ["nhls", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "type": "row", "title": "Business", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "Applications submitted", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(nhls_applications_submitted_total{application=\"wb-nhls\"}) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Notifications pending in outbox", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(nhls_notifications_pending{application=\"wb-nhls\"})" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 50 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "timeseries", "title": "Workflow transitions (per 5m, by target status)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (to) (increase(nhls_workflow_transitions_total{application=\"wb-nhls\"}[5m]))", "legendFormat": "{{to}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Notifications (per 5m)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (increase(nhls_notifications_total{application=\"wb-nhls\"}[5m]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    },

    { "type": "row", "title": "HTTP", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "Requests per second (by endpoint)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"wb-nhls\", uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{method}} {{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "p95 latency (by endpoint)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"wb-nhls\", uri!~\"/actuator.*\"}[5m])))", "legendFormat": "{{method}} {{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Responses by status code", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"wb-nhls\", uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },

    { "type": "row", "title": "JVM and resources", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "JVM heap", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"wb-nhls\", area=\"heap\"})", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(jvm_memory_committed_bytes{application=\"wb-nhls\", area=\"heap\"})", "legendFormat": "committed" },
        { "refId": "C", "expr": "sum(jvm_memory_max_bytes{application=\"wb-nhls\", area=\"heap\"})", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Threads (JVM and Tomcat pool)", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jvm_threads_live_threads{application=\"wb-nhls\"}", "legendFormat": "JVM live" },
        { "refId": "B", "expr": "sum(tomcat_threads_busy_threads{application=\"wb-nhls\"})", "legendFormat": "Tomcat busy" },
        { "refId": "C", "expr": "sum(tomcat_threads_current_threads{application=\"wb-nhls\"})", "legendFormat": "Tomcat current" }
      ]
    },
    {
      "type": "timeseries", "title": "DB connection pool (Hikari)", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{application=\"wb-nhls\"})", "legendFormat": "active" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{application=\"wb-nhls\"})", "legendFormat": "idle" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{application=\"wb-nhls\"})", "legendFormat": "waiting" }
      ]
    },

    { "type": "row", "title": "Logs (Loki)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "collapsed": false, "panels": [] },
    {
      "type": "logs", "title": "Warnings and errors", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{app=\"wb-nhls\", level=~\"WARN|ERROR\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "type": "logs", "title": "All logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 49 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{app=\"wb-nhls\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
